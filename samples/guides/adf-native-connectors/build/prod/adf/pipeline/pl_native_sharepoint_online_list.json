{
	"name": "pl_native_sharepoint_online_list",
	"properties": {
		"parameters": {
			"windowStart": {
				"type": "string"
			},
			"windowEnd": {
				"type": "string"
			}
		},
		"activities": [
			{
				"name": "copy_sharepoint_online_list_records",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_native_sharepoint_online_list_sharepoint_online_list_records",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_native_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": "native/sharepoint-online-list/orders",
							"file": "@{concat(formatDateTime(pipeline().parameters.windowStart, 'yyyyMMddHHmmss'), '_', pipeline().RunId, '.parquet')}"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "SharePointOnlineListSource"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "invoice_id"
								},
								"sink": {
									"name": "invoice_id"
								}
							},
							{
								"source": {
									"name": "amount"
								},
								"sink": {
									"name": "amount"
								}
							},
							{
								"source": {
									"name": "modified_at"
								},
								"sink": {
									"name": "modified_at"
								}
							}
						]
					}
				}
			}
		]
	}
}
