{
	"name": "ls_native_teradata",
	"properties": {
		"type": "Teradata",
		"version": "2.0",
		"typeProperties": {
			"authenticationType": "Basic",
			"sslMode": "Verify-Full",
			"server": "source.example.test",
			"username": "reader",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-password"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
