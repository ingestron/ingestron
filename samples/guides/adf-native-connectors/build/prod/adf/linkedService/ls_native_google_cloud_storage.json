{
	"name": "ls_native_google_cloud_storage",
	"properties": {
		"type": "GoogleCloudStorage",
		"typeProperties": {
			"serviceUrl": "https://storage.googleapis.com",
			"accessKeyId": "synthetic-access_key",
			"secretAccessKey": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-secret-key"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
