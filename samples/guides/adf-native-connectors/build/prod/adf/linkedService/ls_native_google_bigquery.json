{
	"name": "ls_native_google_bigquery",
	"properties": {
		"type": "GoogleBigQueryV2",
		"version": "1.1",
		"typeProperties": {
			"authenticationType": "ServiceAuthentication",
			"projectId": "synthetic-project_id",
			"keyFileContent": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-key-file"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
