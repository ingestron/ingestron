{
	"name": "ds_native_google_cloud_storage",
	"properties": {
		"type": "Binary",
		"linkedServiceName": {
			"referenceName": "ls_native_google_cloud_storage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder": {
				"type": "string"
			},
			"root": {
				"type": "string"
			}
		},
		"typeProperties": {
			"location": {
				"type": "GoogleCloudStorageLocation",
				"bucketName": {
					"value": "@dataset().root",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				}
			}
		}
	}
}
