			"companyId": "synthetic-company_id",
			"consumerKey": "synthetic-client",
			"consumerSecret": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-client-secret"
			},
			"refreshToken": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-refresh-token"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
