{
	"name": "ls_native_impala",
	"properties": {
		"type": "Impala",
		"version": "2.0",
		"typeProperties": {
			"enableSsl": true,
			"enableServerCertificateValidation": true,
			"authenticationType": "UsernameAndPassword",
			"host": "source.example.test",
			"port": 5432,
			"username": "reader",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-password"
			},
			"thriftTransportProtocol": "Binary"
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
