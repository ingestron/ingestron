{
	"name": "ls_native_sharepoint_online_list",
	"properties": {
		"type": "SharePointOnlineList",
		"typeProperties": {
			"servicePrincipalCredentialType": "ServicePrincipalCert",
			"siteUrl": "https://source.example.test",
			"tenantId": "synthetic-tenant",
			"servicePrincipalId": "synthetic-client",
			"servicePrincipalEmbeddedCert": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-certificate"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
