{
	"name": "ls_native_azure_sql_managed_instance_sales",
	"properties": {
		"type": "AzureSqlMI",
		"typeProperties": {
			"server": "source.example.test",
			"database": "sales",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "reader",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_native_secrets",
					"type": "LinkedServiceReference"
				},
				"secretName": "source-password"
			}
		},
		"connectVia": {
			"referenceName": "synthetic-self-hosted-runtime",
			"type": "IntegrationRuntimeReference"
		}
	}
}
