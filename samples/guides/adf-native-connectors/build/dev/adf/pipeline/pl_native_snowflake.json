{
	"name": "pl_native_snowflake",
	"properties": {
		"parameters": {
			"windowStart": {
				"type": "string"
			},
			"windowEnd": {
				"type": "string"
			}
		},
		"activities": [
			{
				"name": "copy_snowflake_records",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_native_snowflake_snowflake_records",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_native_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": "native/snowflake/sales.orders",
							"file": "@{concat(formatDateTime(pipeline().parameters.windowStart, 'yyyyMMddHHmmss'), '_', pipeline().RunId, '.parquet')}"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "SnowflakeV2Source",
						"exportSettings": {
							"type": "SnowflakeExportCopyCommand"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "MergeFiles"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "ls_native_snowflake_export",
							"type": "LinkedServiceReference"
						},
						"path": "staging/orders"
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "invoice_id"
								},
								"sink": {
									"name": "invoice_id"
								}
							},
							{
								"source": {
									"name": "amount"
								},
								"sink": {
									"name": "amount"
								}
							},
							{
								"source": {
									"name": "modified_at"
								},
								"sink": {
									"name": "modified_at"
								}
							}
						]
					}
				}
			}
		]
	}
}
