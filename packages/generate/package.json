{
  "name": "@ingestron/generate",
  "version": "0.2.0",
  "description": "Plan, diff and apply generated files safely, keeping hand edits.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:examples": "tsx scripts/check-examples.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:examples && pnpm check:docs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/ingestron.git",
    "directory": "packages/generate"
  }
}
