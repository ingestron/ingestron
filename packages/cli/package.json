{
  "name": "@ingestron/cli",
  "version": "1.5.0",
  "description": "ingestron plan | apply | check | schemas: generate platform assets from definitions.",
  "license": "Apache-2.0",
  "author": "IntentLabs <hello@ingestron.io>",
  "homepage": "https://docs.ingestron.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/ingestron.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ingestron/ingestron/issues",
    "email": "hello@ingestron.io"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "ingestron": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "project-templates",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:docs": "tsx scripts/check-docs.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs && pnpm check:api",
    "check:bundle": "tsx scripts/check-bundle-schema.ts",
    "api": "api-extractor run --local",
    "check:api": "api-extractor run",
    "prepack": "pnpm build && cp ../../NOTICE NOTICE"
  },
  "dependencies": {
    "@ingestron/config": "workspace:^",
    "@ingestron/definitions": "workspace:^",
    "@ingestron/generate": "workspace:^",
    "@ingestron/pack-adf": "^1.3.0",
    "@ingestron/pack-databricks": "^1.0.1",
    "@ingestron/pack-duckdb": "^1.2.0",
    "@ingestron/pack-synapse": "^1.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "vscode-languageserver-textdocument": "1.0.12",
    "yaml-language-server": "1.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
