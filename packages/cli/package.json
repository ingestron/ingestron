{
  "name": "@ingestron/cli",
  "version": "1.0.0",
  "description": "ingestron plan | apply | check | schemas: generate platform assets from definitions.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "ingestron": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "project-templates",
    "project-recipes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-project-data.mjs",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:examples": "tsx scripts/check-examples.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:examples && pnpm check:docs",
    "check:parity": "tsx scripts/check-template-parity.ts",
    "check:bundle": "tsx scripts/check-bundle-schema.ts"
  },
  "dependencies": {
    "@ingestron/definitions": "workspace:*",
    "@ingestron/generate": "workspace:*",
    "@ingestron/pack-adf": "workspace:*",
    "@ingestron/pack-databricks": "workspace:*",
    "@ingestron/config": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "vscode-languageserver-textdocument": "1.0.12",
    "yaml-language-server": "1.25.0"
  }
}
