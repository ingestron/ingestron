exports[`keeps the ADF files generated for private-sql-server > dev 1`] = `
{
  "dataset/ds_erp_erp_erp.json": "{
	"name": "ds_erp_erp_erp",
	"properties": {
		"type": "SqlServerTable",
		"linkedServiceName": {
			"referenceName": "ls_erp_erp_erp",
			"type": "LinkedServiceReference"
		}
	}
}
",
  "dataset/ds_erp_landing.json": "{
	"name": "ds_erp_landing",
	"properties": {
		"type": "Parquet",
		"linkedServiceName": {
			"referenceName": "ls_erp_landing",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileSystem": "landing",
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				},
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		}
	}
}
",
  "linkedService/ls_erp_erp_erp.json": "{
	"name": "ls_erp_erp_erp",
	"properties": {
		"type": "SqlServer",
		"typeProperties": {
			"server": "erp-sql01.corp.local",
			"database": "erp",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "ingest_reader",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_erp_keyvault",
					"type": "LinkedServiceReference"
				},
				"secretName": "erp-sql-password"
			}
		},
		"connectVia": {
			"referenceName": "shir-erp",
			"type": "IntegrationRuntimeReference"
		}
	}
}
",
  "linkedService/ls_erp_keyvault.json": "{
	"name": "ls_erp_keyvault",
	"properties": {
		"type": "AzureKeyVault",
		"typeProperties": {
			"baseUrl": "https://kv-erp-dev.vault.azure.net"
		}
	}
}
",
  "linkedService/ls_erp_landing.json": "{
	"name": "ls_erp_landing",
	"properties": {
		"type": "AzureBlobFS",
		"typeProperties": {
			"url": "https://erplakedev.dfs.core.windows.net"
		}
	}
}
",
  "pipeline/pl_erp_erp.json": "{
	"name": "pl_erp_erp",
	"properties": {
		"activities": [
			{
				"name": "copy_customers",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_erp_erp_erp",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_erp_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "erp/erp.dbo.Customers",
							"file": "@{concat(formatDateTime(pipeline().parameters.windowStart, 'yyyyMMddHHmmss'), '_', pipeline().RunId, '.parquet')}"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "SELECT [customer_id], [name], [country], [modified_at] FROM [dbo].[Customers] WHERE [modified_at] >= '@{formatDateTime(pipeline().parameters.windowStart, 'yyyy-MM-dd HH:mm:ss')}' AND [modified_at] < '@{formatDateTime(pipeline().parameters.windowEnd, 'yyyy-MM-dd HH:mm:ss')}'",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					}
				}
			},
			{
				"name": "copy_invoices",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_erp_erp_erp",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_erp_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "erp/erp.dbo.Invoices",
							"file": "@{concat(formatDateTime(pipeline().parameters.windowStart, 'yyyyMMddHHmmss'), '_', pipeline().RunId, '.parquet')}"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "SELECT [invoice_id], [customer_id], [amount], [status], [updated_at] FROM [dbo].[Invoices] WHERE [updated_at] >= '@{formatDateTime(pipeline().parameters.windowStart, 'yyyy-MM-dd HH:mm:ss')}' AND [updated_at] < '@{formatDateTime(pipeline().parameters.windowEnd, 'yyyy-MM-dd HH:mm:ss')}'",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					}
				}
			}
		],
		"parameters": {
			"windowStart": {
				"type": "string"
			},
			"windowEnd": {
				"type": "string"
			}
		},
		"annotations": [
			"Generated by Ingestron from the erp definitions"
		]
	}
}
",
  "trigger/tr_erp_erp.json": "{
	"name": "tr_erp_erp",
	"properties": {
		"type": "TumblingWindowTrigger",
		"runtimeState": "Stopped",
		"typeProperties": {
			"frequency": "Hour",
			"interval": 1,
			"startTime": "2026-10-01T00:00:00Z",
			"maxConcurrency": 1,
			"retryPolicy": {
				"count": 2,
				"intervalInSeconds": 300
			}
		},
		"pipeline": {
			"pipelineReference": {
				"referenceName": "pl_erp_erp",
				"type": "PipelineReference"
			},
			"parameters": {
				"windowStart": "@trigger().outputs.windowStartTime",
				"windowEnd": "@trigger().outputs.windowEndTime"
			}
		}
	}
}
",
}
`;

