// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`keeps the ADF files generated for private-files > dev 1`] = `
{
  "dataset/ds_stores_landing_files.json": "{
	"name": "ds_stores_landing_files",
	"properties": {
		"type": "Binary",
		"linkedServiceName": {
			"referenceName": "ls_stores_landing",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder": {
				"type": "string"
			}
		},
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileSystem": "landing",
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				}
			}
		}
	}
}
",
  "dataset/ds_stores_share.json": "{
	"name": "ds_stores_share",
	"properties": {
		"type": "Binary",
		"linkedServiceName": {
			"referenceName": "ls_stores_share",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder": {
				"type": "string"
			}
		},
		"typeProperties": {
			"location": {
				"type": "FileServerLocation",
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				}
			}
		}
	}
}
",
  "linkedService/ls_stores_keyvault.json": "{
	"name": "ls_stores_keyvault",
	"properties": {
		"type": "AzureKeyVault",
		"typeProperties": {
			"baseUrl": "https://kv-stores-dev.vault.azure.net"
		}
	}
}
",
  "linkedService/ls_stores_landing.json": "{
	"name": "ls_stores_landing",
	"properties": {
		"type": "AzureBlobFS",
		"typeProperties": {
			"url": "https://storeslakedev.dfs.core.windows.net"
		}
	}
}
",
  "linkedService/ls_stores_share.json": "{
	"name": "ls_stores_share",
	"properties": {
		"type": "FileServer",
		"typeProperties": {
			"host": "\\\\\\\\fs01\\\\exports",
			"userId": "corp\\\\ingest",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_stores_keyvault",
					"type": "LinkedServiceReference"
				},
				"secretName": "fs01-password"
			}
		},
		"connectVia": {
			"referenceName": "shir-stores",
			"type": "IntegrationRuntimeReference"
		}
	}
}
",
  "pipeline/pl_stores_share.json": "{
	"name": "pl_stores_share",
	"properties": {
		"activities": [
			{
				"name": "copy_sales",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_stores_share",
						"type": "DatasetReference",
						"parameters": {
							"folder": "sales"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_stores_landing_files",
						"type": "DatasetReference",
						"parameters": {
							"folder": "stores/sales"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": true,
							"wildcardFileName": "*",
							"modifiedDatetimeStart": "@{formatDateTime(pipeline().parameters.windowStart, 'yyyy-MM-dd''T''HH:mm:ss''Z''')}",
							"modifiedDatetimeEnd": "@{formatDateTime(pipeline().parameters.windowEnd, 'yyyy-MM-dd''T''HH:mm:ss''Z''')}"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					}
				}
			},
			{
				"name": "copy_stock",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_stores_share",
						"type": "DatasetReference",
						"parameters": {
							"folder": "stock"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_stores_landing_files",
						"type": "DatasetReference",
						"parameters": {
							"folder": "stores/stock"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": true,
							"wildcardFileName": "*",
							"modifiedDatetimeStart": "@{formatDateTime(pipeline().parameters.windowStart, 'yyyy-MM-dd''T''HH:mm:ss''Z''')}",
							"modifiedDatetimeEnd": "@{formatDateTime(pipeline().parameters.windowEnd, 'yyyy-MM-dd''T''HH:mm:ss''Z''')}"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					}
				}
			}
		],
		"parameters": {
			"windowStart": {
				"type": "string"
			},
			"windowEnd": {
				"type": "string"
			}
		},
		"annotations": [
			"Generated by Ingestron from the stores definitions"
		]
	}
}
",
  "trigger/tr_stores_share.json": "{
	"name": "tr_stores_share",
	"properties": {
		"type": "TumblingWindowTrigger",
		"runtimeState": "Stopped",
		"typeProperties": {
			"frequency": "Hour",
			"interval": 1,
			"startTime": "2026-10-01T00:00:00Z",
			"maxConcurrency": 1,
			"retryPolicy": {
				"count": 2,
				"intervalInSeconds": 300
			}
		},
		"pipeline": {
			"pipelineReference": {
				"referenceName": "pl_stores_share",
				"type": "PipelineReference"
			},
			"parameters": {
				"windowStart": "@trigger().outputs.windowStartTime",
				"windowEnd": "@trigger().outputs.windowEndTime"
			}
		}
	}
}
",
}
`;

