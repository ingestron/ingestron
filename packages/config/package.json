{
  "name": "@ingestron/config",
  "version": "1.1.0",
  "description": "Multi-file YAML definitions with references, environments and schema validation.",
  "license": "Apache-2.0",
  "author": "IntentLabs <hello@ingestron.io>",
  "homepage": "https://docs.ingestron.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/ingestron.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/ingestron/ingestron/issues",
    "email": "hello@ingestron.io"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:docs": "tsx scripts/check-docs.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs && pnpm check:api",
    "api": "api-extractor run --local && api-extractor run --local -c api-extractor.core.json",
    "check:api": "api-extractor run && api-extractor run -c api-extractor.core.json",
    "prepack": "pnpm build && cp ../../NOTICE NOTICE"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "vscode-languageserver-textdocument": "1.0.12",
    "yaml-language-server": "1.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
