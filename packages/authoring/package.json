{
  "name": "@ingestron/authoring",
  "version": "1.2.0",
  "description": "Editor features for Ingestron projects as plain functions: problems, quick fixes, completion, hover, navigation and previews.",
  "license": "Apache-2.0",
  "author": "IntentLabs <hello@ingestron.io>",
  "homepage": "https://docs.ingestron.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/ingestron.git",
    "directory": "packages/authoring"
  },
  "bugs": {
    "url": "https://github.com/ingestron/ingestron/issues",
    "email": "hello@ingestron.io"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:api",
    "api": "api-extractor run --local",
    "check:api": "api-extractor run",
    "prepack": "pnpm build && cp ../../NOTICE NOTICE"
  },
  "dependencies": {
    "@ingestron/cli": "workspace:^",
    "@ingestron/config": "workspace:^",
    "@ingestron/definitions": "workspace:^",
    "@ingestron/generate": "workspace:^",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@ingestron/pack-adf": "^1.1.0",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
