{
  "name": "@ingestron/authoring",
  "version": "0.1.0",
  "description": "Editor features for Ingestron projects as plain functions: problems, quick fixes, completion, hover, navigation and previews.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ingestron/cli": "workspace:*",
    "@ingestron/definitions": "workspace:*",
    "@ingestron/generate": "workspace:*",
    "@ingestron/config": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
